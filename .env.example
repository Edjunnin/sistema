# --------------------------------------------------------------------
# Modelo de configuração por ambiente
# --------------------------------------------------------------------
# Os valores padrão do projeto (em app/Config) já apontam para o
# servidor da faculdade. Este arquivo serve para sobrescrever esses
# valores no SEU computador.
#
# Copie este arquivo para ".env" na máquina onde for rodar:
#
#   Copiar-Item .env.example .env      (PowerShell)
#   cp .env.example .env               (Linux/Mac)
#
# O ".env" NÃO vai para o Git. Assim cada máquina tem o seu.
# --------------------------------------------------------------------

CI_ENVIRONMENT = development

# ------------------- URL do sistema -------------------
# Em casa (a porta 8080 do seu PC pode estar ocupada pelo Steam):
app.baseURL = 'http://localhost:8081/'

# No servidor do professor NÃO precisa de .env, pois o padrão
# em app/Config/App.php já é a URL de lá:
# app.baseURL = 'http://192.168.51.20/a28408/ads209/sistema/public/'

# ------------------- Banco de dados local -------------------
database.default.hostname = localhost
database.default.database = sistema
database.default.username = root
database.default.password = ''
database.default.DBDriver = MySQLi
database.default.port = 3306

# No servidor do professor (já é o padrão no código):
# database.default.username = a28408
# database.default.password = '123456'
# database.default.database = a28408
